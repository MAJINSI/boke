---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: var(--article);
    color: var(--text);
    font-size: 1.03rem;
  }

  .prose :global(p) { margin: 0 0 1.35em; }
  .prose :global(h2), .prose :global(h3) {
    margin: 2.4em 0 0.8em;
    font-family: "Songti SC", STSong, SimSun, serif;
    font-weight: 400;
    line-height: 1.25;
  }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(blockquote) {
    margin: 2em 0;
    padding-left: 1.2em;
    border-left: 1px solid var(--gold);
    color: var(--muted);
  }
</style>
