---
import type { CollectionEntry } from "astro:content";
import { dateFormatter, eventHref } from "../lib/content";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  event: CollectionEntry<"teaEvents">;
}
const { event } = Astro.props;
---

<article class="event-card">
  <a href={eventHref(event)} aria-label={`查看${event.data.title}席位`}>
    <div class="topline">
      <span>{event.data.season}</span>
      <StatusBadge status={event.data.status} label={event.data.status_label} />
    </div>
    <h3 class="title-serif">{event.data.title}</h3>
    <p class="summary">{event.data.summary}</p>
    <dl>
      <div><dt>日期</dt><dd>{dateFormatter.format(event.data.date)}</dd></div>
      <div><dt>城市</dt><dd>{event.data.city}</dd></div>
      <div><dt>席位</dt><dd>{event.data.seats}</dd></div>
      <div><dt>茶品</dt><dd>{event.data.tea_types.join("、")}</dd></div>
    </dl>
    <span class="card-link">查看席位</span>
  </a>
</article>

<style>
  .event-card a {
    display: grid;
    min-height: 100%;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--line);
    background: rgba(255, 250, 240, 0.42);
    transition: border-color 180ms ease, background 180ms ease;
  }

  .event-card a:hover {
    border-color: var(--gold);
    background: rgba(255, 250, 240, 0.66);
  }

  .topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    color: var(--muted);
    font-size: 0.84rem;
  }

  h3 {
    margin: 30px 0 12px;
    font-size: clamp(1.55rem, 2.4vw, 2.2rem);
    line-height: 1.22;
  }

  .summary {
    min-height: 3.6em;
    margin: 0 0 26px;
    color: var(--muted);
  }

  dl {
    display: grid;
    gap: 9px;
    margin: 0 0 30px;
  }

  dl div {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 14px;
  }

  dt {
    color: var(--muted);
    font-size: 0.82rem;
  }

  dd { margin: 0; }

  .card-link {
    align-self: end;
    color: var(--pu-erh);
    font-size: 0.9rem;
  }
</style>
