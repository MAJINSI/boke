---
interface Props {
  tallyUrl?: string;
}
const { tallyUrl = "" } = Astro.props;
---

{
  tallyUrl ? (
    <iframe
      class="tally"
      src={tallyUrl}
      title="入席申请表单"
      loading="lazy"
      width="100%"
      height="720"
    />
  ) : (
    <section class="tally-placeholder" aria-label="Tally 表单占位">
      <p class="eyebrow">TALLY FORM</p>
      <h2 class="title-serif">请在后台配置 Tally 表单链接</h2>
      <p>配置完成后，这里会自动显示入席申请表单。建议字段包括称呼、联系方式、所在城市、希望参加的茶会、同行人数与是否接受候补。</p>
    </section>
  )
}

<style>
  .tally {
    width: 100%;
    min-height: 720px;
    border: 1px solid var(--line);
    background: #fffaf0;
  }

  .tally-placeholder {
    display: grid;
    min-height: 430px;
    place-content: center;
    padding: 44px;
    border: 1px solid var(--line);
    background:
      linear-gradient(135deg, rgba(138, 154, 139, 0.18), transparent 46%),
      rgba(255, 250, 240, 0.54);
    text-align: center;
  }

  h2 {
    margin: 10px 0 12px;
    font-size: clamp(1.8rem, 4vw, 3.6rem);
    font-weight: 400;
  }

  p:last-child {
    max-width: 560px;
    margin: 0 auto;
    color: var(--muted);
  }
</style>
