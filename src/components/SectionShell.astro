---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  theme?: "light" | "dark" | "paper";
  narrow?: boolean;
}

const { eyebrow, title, intro, theme = "paper", narrow = false } = Astro.props;
---

<section class:list={["section-shell", theme]}>
  <div class:list={["container", narrow && "narrow"]}>
    <header class="section-head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="title-serif">{title}</h2>
      {intro && <p>{intro}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section-shell {
    padding: var(--space) 0;
  }

  .section-shell.dark {
    background: var(--ink);
    color: var(--paper);
  }

  .section-shell.light { background: #fffaf0; }
  .section-shell.paper { background: var(--paper); }
  .narrow { max-width: var(--article); }

  .section-head {
    max-width: 720px;
    margin-bottom: clamp(34px, 6vw, 68px);
  }

  .section-head h2 {
    margin: 10px 0 0;
    font-size: clamp(2rem, 4.4vw, 4.8rem);
    line-height: 1.16;
    font-weight: 400;
  }

  .section-head p:not(.eyebrow) {
    margin: 18px 0 0;
    color: var(--muted);
  }

  .dark .section-head p:not(.eyebrow) { color: rgba(243, 239, 230, 0.62); }
</style>
