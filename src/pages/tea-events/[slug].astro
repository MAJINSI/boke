---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTASection from "../../components/CTASection.astro";
import Prose from "../../components/Prose.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { dateFormatter, getSetting } from "../../lib/content";

export async function getStaticPaths() {
  const events = await getCollection("teaEvents");
  return events.map((event) => ({ params: { slug: event.data.slug }, props: { event } }));
}

const { event } = Astro.props;
const settings = getSetting(await getCollection("settings"));
const { Content } = await render(event);
---

<BaseLayout
  title={event.data.seo_title || event.data.title}
  description={event.data.seo_description || event.data.summary}
  brandName={settings?.brand_name}
  footerText={settings?.footer_text}
  image={event.data.cover_image || "/uploads/brand-assets/tea-event-rain-white-tea-cover.jpg"}
>
  <article class="event-detail">
    <div class="container detail-grid">
      <header>
        <p class="eyebrow">{event.data.season} · {event.data.city}</p>
        <h1 class="title-serif">{event.data.title}</h1>
        {event.data.subtitle && <p class="subtitle">{event.data.subtitle}</p>}
        <StatusBadge status={event.data.status} label={event.data.status_label} />
      </header>
      <aside aria-label="茶会信息">
        <dl>
          <div><dt>日期</dt><dd>{dateFormatter.format(event.data.date)}</dd></div>
          <div><dt>城市</dt><dd>{event.data.city}</dd></div>
          <div><dt>地点</dt><dd>{event.data.venue_note || "确认后告知"}</dd></div>
          <div><dt>席位</dt><dd>{event.data.seats}</dd></div>
          <div><dt>价格</dt><dd>{event.data.price}</dd></div>
          <div><dt>茶品</dt><dd>{event.data.tea_types.join("、")}</dd></div>
          <div><dt>器物</dt><dd>{event.data.objects.join("、") || "依席面选择"}</dd></div>
          <div><dt>主理人</dt><dd>{event.data.host || settings?.brand_name}</dd></div>
          <div><dt>适合</dt><dd>{event.data.suitable_for.join("、")}</dd></div>
        </dl>
        <a class="button" href="/enter">申请入席</a>
      </aside>
    </div>
    <div class="container media">
      <div class="image-placeholder">
        {event.data.cover_image ? <img src={event.data.cover_image} alt={event.data.title} /> : <span>{event.data.title}</span>}
      </div>
    </div>
    <div class="container prose-wrap">
      <Prose><Content /></Prose>
    </div>
    {event.data.gallery.length > 0 && (
      <div class="container gallery" aria-label="茶会图集">
        {event.data.gallery.map((image) => <div class="image-placeholder"><img src={image} alt={`${event.data.title}图集`} loading="lazy" /></div>)}
      </div>
    )}
  </article>
  <CTASection />
</BaseLayout>

<style>
  .event-detail { padding: var(--space) 0 0; }
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    gap: clamp(38px, 8vw, 100px);
    align-items: start;
  }
  h1 {
    max-width: 780px;
    margin: 14px 0 18px;
    font-size: clamp(2.8rem, 7vw, 6rem);
    line-height: 1.1;
  }
  .subtitle {
    max-width: 620px;
    margin: 0 0 24px;
    color: var(--muted);
    font-size: 1.12rem;
  }
  aside {
    border-top: 1px solid var(--gold);
    padding-top: 24px;
  }
  dl {
    display: grid;
    gap: 13px;
    margin: 0 0 30px;
  }
  dl div {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 18px;
  }
  dt { color: var(--muted); }
  dd { margin: 0; }
  .media { margin-top: 70px; }
  .media .image-placeholder { min-height: 420px; aspect-ratio: 16 / 7; }
  .prose-wrap { margin-top: 64px; }
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 52px;
    margin-bottom: var(--space);
  }
  @media (max-width: 820px) {
    .detail-grid, .gallery { grid-template-columns: 1fr; }
    .media .image-placeholder { min-height: 260px; aspect-ratio: 4 / 3; }
  }
</style>
