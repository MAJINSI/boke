---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import NoteCard from "../components/NoteCard.astro";
import ObjectCard from "../components/ObjectCard.astro";
import SectionShell from "../components/SectionShell.astro";
import TeaEventCard from "../components/TeaEventCard.astro";
import { byDateDesc, byOrder, getSetting } from "../lib/content";

const settings = getSetting(await getCollection("settings"));
const events = byDateDesc(await getCollection("teaEvents"));
const featuredEvents = events.filter((event) => event.data.featured_on_home).slice(0, 3);
const objects = byOrder(await getCollection("objects"));
const featuredObjects = objects.filter((object) => object.data.featured).slice(0, 3);
const notes = byDateDesc(await getCollection("notes"));
const featuredNotes = notes.filter((note) => note.data.featured).slice(0, 3);
const homeBlocks = byOrder((await getCollection("homeBlocks")).filter((block) => block.data.show));
---

<BaseLayout
  title={settings?.seo_title ?? "入席之前"}
  description={settings?.seo_description ?? "私人茶席、器物审美与东方生活方式体验。"}
  brandName={settings?.brand_name}
  footerText={settings?.footer_text}
  image={settings?.hero_image || "/uploads/brand-assets/hero-empty-seat.jpg"}
>
  <Hero
    brandName={settings?.brand_name ?? "半席"}
    title={settings?.hero_title ?? "一席茶，安放一段不被打扰的时间。"}
    subtitle={settings?.hero_subtitle ?? "私人茶席、器物审美与东方生活方式体验。"}
    eyebrow={settings?.hero_eyebrow ?? "PRIVATE TEA SALON"}
    image={settings?.hero_image || "/uploads/brand-assets/hero-empty-seat.jpg"}
  />

  <SectionShell eyebrow="BEFORE ENTERING" title="入席之前" intro="这里不是茶的说明书，而是一处尚未开始的席面。">
    <div class="claims">
      <p>茶不是饮品，是时间的方式。</p>
      <p>器不是装饰，是身体的尺度。</p>
      <p>一席不是活动，是人与人之间的缓慢抵达。</p>
    </div>
  </SectionShell>

  {homeBlocks.map((block) => (
    <section class:list={["home-block", block.data.theme, block.data.layout]}>
      <div class="container block-grid">
        <div class="block-copy">
          {block.data.subtitle && <p class="eyebrow">{block.data.subtitle}</p>}
          <h2 class="title-serif">{block.data.title}</h2>
          {block.data.body && <p>{block.data.body}</p>}
          {block.data.button_text && block.data.button_link && <a class:list={["button", block.data.theme === "dark" && "dark"]} href={block.data.button_link}>{block.data.button_text}</a>}
        </div>
        {block.data.layout !== "full" && (
          <div class="image-placeholder">
            {block.data.image ? <img src={block.data.image} alt={block.data.title} loading="lazy" /> : <span>{block.data.title}</span>}
          </div>
        )}
      </div>
    </section>
  ))}

  <SectionShell eyebrow="SEASONAL SEATS" title="本季茶会" intro="茶、器、席、光与空间，在开始前已经完成选择。">
    <div class="card-grid events">
      {featuredEvents.length ? featuredEvents.map((event) => <TeaEventCard event={event} />) : <p class="empty">本季茶会仍在整理。</p>}
    </div>
  </SectionShell>

  <SectionShell eyebrow="OBJECTS" title="器物与席面" theme="light">
    <div class="object-grid">
      {featuredObjects.length ? featuredObjects.map((object) => <ObjectCard object={object} />) : <p class="empty">器物仍在整理。</p>}
    </div>
  </SectionShell>

  <SectionShell eyebrow="HOST NOTE" title="主人手记" narrow>
    <p class="host-note">{settings?.host_note}</p>
  </SectionShell>

  <SectionShell eyebrow="NOTES" title="札记精选">
    <div class="card-grid">
      {featuredNotes.length ? featuredNotes.map((note) => <NoteCard note={note} />) : <p class="empty">札记仍在整理。</p>}
    </div>
  </SectionShell>

  <CTASection />
</BaseLayout>

<style>
  .claims {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .claims p {
    min-height: 220px;
    margin: 0;
    padding: clamp(26px, 4vw, 44px);
    background: var(--paper);
    font-family: "Songti SC", STSong, SimSun, serif;
    font-size: clamp(1.28rem, 2vw, 1.72rem);
    line-height: 1.75;
  }

  .home-block {
    padding: var(--space) 0;
    border-top: 1px solid var(--line);
  }

  .home-block.dark {
    background: var(--ink);
    color: var(--paper);
    border-top-color: var(--line-dark);
  }

  .home-block.light { background: #fffaf0; }
  .home-block.paper { background: var(--paper); }

  .block-grid {
    display: grid;
    grid-template-columns: 1fr 0.86fr;
    gap: clamp(34px, 7vw, 90px);
    align-items: center;
  }

  .home-block.right .block-copy { order: 2; }
  .home-block.full .block-grid { grid-template-columns: 1fr; }

  .block-copy h2 {
    max-width: 760px;
    margin: 10px 0 0;
    font-size: clamp(2rem, 4.5vw, 4.6rem);
    line-height: 1.16;
  }

  .block-copy p:not(.eyebrow) {
    max-width: 620px;
    margin: 22px 0 0;
    color: var(--muted);
  }

  .dark .block-copy p:not(.eyebrow) { color: rgba(243, 239, 230, 0.66); }
  .block-copy .button { margin-top: 30px; }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .object-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px 42px;
  }

  .host-note {
    margin: 0;
    font-family: "Songti SC", STSong, SimSun, serif;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.8;
  }

  .empty { color: var(--muted); }

  @media (max-width: 880px) {
    .claims, .card-grid, .object-grid, .block-grid {
      grid-template-columns: 1fr;
    }
    .home-block.right .block-copy { order: initial; }
  }
</style>
