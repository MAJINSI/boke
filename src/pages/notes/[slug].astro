---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Prose from "../../components/Prose.astro";
import { byDateDesc, dateFormatter, getSetting, noteHref } from "../../lib/content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.data.slug }, props: { note } }));
}

const { note } = Astro.props;
const settings = getSetting(await getCollection("settings"));
const notes = byDateDesc(await getCollection("notes"));
const currentIndex = notes.findIndex((item) => item.data.slug === note.data.slug);
const prev = notes[currentIndex - 1];
const next = notes[currentIndex + 1];
const { Content } = await render(note);
---

<BaseLayout
  title={note.data.seo_title || note.data.title}
  description={note.data.seo_description || note.data.summary}
  brandName={settings?.brand_name}
  footerText={settings?.footer_text}
  image={note.data.cover_image || "/uploads/brand-assets/note-spring-before-seat-cover.jpg"}
>
  <article class="note-detail">
    <header class="container article-head">
      <p class="eyebrow">{note.data.category} · {dateFormatter.format(note.data.date)}</p>
      <h1 class="title-serif">{note.data.title}</h1>
      <p>{note.data.summary}</p>
    </header>
    <div class="container cover">
      <div class="image-placeholder">
        {note.data.cover_image ? <img src={note.data.cover_image} alt={note.data.title} /> : <span>{note.data.category}</span>}
      </div>
    </div>
    <div class="container article-body">
      <Prose><Content /></Prose>
      <nav class="pager" aria-label="上一篇和下一篇">
        {prev ? <a href={noteHref(prev)}>上一篇：{prev.data.title}</a> : <span></span>}
        {next ? <a href={noteHref(next)}>下一篇：{next.data.title}</a> : <span></span>}
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .note-detail { padding: var(--space) 0; }
  .article-head {
    max-width: var(--article);
  }
  h1 {
    margin: 14px 0 18px;
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    line-height: 1.12;
  }
  .article-head p:not(.eyebrow) {
    margin: 0;
    color: var(--muted);
  }
  .cover {
    margin-top: 60px;
  }
  .cover .image-placeholder {
    min-height: 420px;
    aspect-ratio: 16 / 7;
  }
  .article-body {
    max-width: var(--article);
    margin-top: 64px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 76px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
  }
  .pager a:last-child { text-align: right; }
  .pager a:hover { color: var(--pu-erh); }
  @media (max-width: 720px) {
    .cover .image-placeholder { min-height: 260px; aspect-ratio: 4 / 3; }
    .pager { grid-template-columns: 1fr; }
    .pager a:last-child { text-align: left; }
  }
</style>
